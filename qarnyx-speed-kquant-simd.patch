diff -ruN '--exclude=Cargo.lock' a/crates/qarnyx-cpu/benches/perf.rs b/crates/qarnyx-cpu/benches/perf.rs
--- a/crates/qarnyx-cpu/benches/perf.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/qarnyx-cpu/benches/perf.rs	2026-11-18 07:32:18.000000000 +0000
@@ -0,0 +1,165 @@
+//! Realistic-shape throughput benchmark (single backend, steady state).
+//!
+//! Run with: cargo bench -p qarnyx-cpu --bench perf
+//! Shapes follow Qwen3.5-2B: FFN [6144, 2048], attention/out [2048, 2048],
+//! and a slice of the Q6_K output head. Reports ms/op, weight GB/s and, for
+//! matmul, GFLOP/s. Weights are sized to exceed L2 so memory behaviour counts.
+
+use std::hint::black_box;
+use std::time::{Duration, Instant};
+
+use qarnyx_core::{Backend, DType, TensorView};
+use qarnyx_cpu::CpuBackend;
+
+fn next(state: &mut u64) -> u64 {
+    *state ^= *state << 13;
+    *state ^= *state >> 7;
+    *state ^= *state << 17;
+    *state
+}
+
+fn quant_rows(raw_type: u32, rows: usize, columns: usize) -> Vec<u8> {
+    let (block_elems, block_bytes, scale_offsets): (usize, usize, &[usize]) = match raw_type {
+        12 => (256, 144, &[0, 2]),
+        13 => (256, 176, &[0, 2]),
+        14 => (256, 210, &[208]),
+        _ => unreachable!(),
+    };
+    let mut state = 0x1234_5678_9abc_def1_u64 ^ raw_type as u64;
+    let mut bytes = vec![0_u8; rows * (columns / block_elems) * block_bytes];
+    for block in bytes.chunks_exact_mut(block_bytes) {
+        for byte in block.iter_mut() {
+            *byte = next(&mut state) as u8;
+        }
+        for &offset in scale_offsets {
+            block[offset..offset + 2].copy_from_slice(&0x2c00_u16.to_le_bytes());
+        }
+    }
+    bytes
+}
+
+fn f32_rows(rows: usize, columns: usize) -> Vec<u8> {
+    let mut state = 0x0bad_cafe_u64;
+    (0..rows * columns)
+        .flat_map(|_| (((next(&mut state) % 2001) as f32 / 1000.0) - 1.0).to_le_bytes())
+        .collect()
+}
+
+fn dtype_of(raw_type: u32) -> DType {
+    match raw_type {
+        0 => DType::F32,
+        12 => DType::Q4K,
+        13 => DType::Q5K,
+        _ => DType::Q6K,
+    }
+}
+
+/// Runs `op` until at least `budget` has elapsed; returns seconds per call (best of 3 windows).
+fn time(budget: Duration, mut op: impl FnMut()) -> f64 {
+    op(); // warm caches and thread-local scratch
+    let mut best = f64::MAX;
+    for _ in 0..3 {
+        let start = Instant::now();
+        let mut iterations = 0_u32;
+        while start.elapsed() < budget {
+            op();
+            iterations += 1;
+        }
+        best = best.min(start.elapsed().as_secs_f64() / f64::from(iterations));
+    }
+    best
+}
+
+fn backends(workers: usize) -> Vec<(&'static str, CpuBackend)> {
+    let all = vec![
+        ("scalar", CpuBackend::new_scalar(workers).unwrap()),
+        ("dequant", CpuBackend::new_dequant(workers).unwrap()), // DEQUANT
+        ("fused-q4k", CpuBackend::new_fused_q4k(workers).unwrap()),
+        ("default", CpuBackend::new(workers).unwrap()),
+    ];
+    // SKIP_SCALAR=1 drops the (very slow) scalar reference from repeated runs.
+    let skip = std::env::var_os("SKIP_SCALAR").is_some();
+    all.into_iter()
+        .filter(|(name, _)| !(skip && *name == "scalar"))
+        .collect()
+}
+
+fn main() {
+    let workers: usize = std::env::var("WORKERS")
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(1);
+    let budget = Duration::from_millis(300);
+    println!("workers={workers}\n\nMatvec (decode):");
+    let cases: [(&str, u32, usize, usize); 5] = [
+        ("Q4_K ffn_up   [6144, 2048]", 12, 6144, 2048),
+        ("Q5_K ffn_up   [6144, 2048]", 13, 6144, 2048),
+        ("Q6_K ffn_down [2048, 6144]", 14, 2048, 6144),
+        ("Q6_K lm_head  [16384, 2048]", 14, 16384, 2048),
+        ("F32  attn_out [2048, 2048]", 0, 2048, 2048),
+    ];
+    for (label, raw_type, rows, columns) in cases {
+        let bytes = if raw_type == 0 {
+            f32_rows(rows, columns)
+        } else {
+            quant_rows(raw_type, rows, columns)
+        };
+        let shape = [rows, columns];
+        let weights = TensorView::new(&bytes, &shape, dtype_of(raw_type));
+        let mut state = 7_u64;
+        let input: Vec<f32> = (0..columns)
+            .map(|_| ((next(&mut state) % 2001) as f32) / 1000.0 - 1.0)
+            .collect();
+        let mut output = vec![0.0_f32; rows];
+        println!("{label}  ({:.1} MB)", bytes.len() as f64 / 1e6);
+        for (name, backend) in backends(workers) {
+            let seconds = time(budget, || {
+                backend
+                    .matvec(weights, black_box(&input), &mut output)
+                    .unwrap();
+                black_box(&output);
+            });
+            println!(
+                "  {name:<10} {:>9.3} ms/op  {:>6.2} GB/s",
+                seconds * 1e3,
+                bytes.len() as f64 / seconds / 1e9
+            );
+        }
+    }
+
+    println!("\nMatmul (prefill, B is [k, n] f32):");
+    let cases: [(&str, u32, usize, usize, usize); 4] = [
+        ("F32  [2048,2048] x n=64 ", 0, 2048, 2048, 64),
+        ("Q4_K [2048,2048] x n=64 ", 12, 2048, 2048, 64),
+        ("Q4_K [2048,2048] x n=256", 12, 2048, 2048, 256),
+        ("Q6_K [2048,2048] x n=37 ", 14, 2048, 2048, 37),
+    ];
+    for (label, raw_type, m, k, n) in cases {
+        let bytes = if raw_type == 0 {
+            f32_rows(m, k)
+        } else {
+            quant_rows(raw_type, m, k)
+        };
+        let shape = [m, k];
+        let weights = TensorView::new(&bytes, &shape, dtype_of(raw_type));
+        let mut state = 11_u64;
+        let b: Vec<f32> = (0..k * n)
+            .map(|_| ((next(&mut state) % 2001) as f32) / 1000.0 - 1.0)
+            .collect();
+        let mut c = vec![0.0_f32; m * n];
+        println!("{label}");
+        for (name, backend) in backends(workers) {
+            let seconds = time(budget, || {
+                backend
+                    .matmul(weights, black_box(&b), &mut c, m, n, k)
+                    .unwrap();
+                black_box(&c);
+            });
+            println!(
+                "  {name:<10} {:>9.2} ms/op  {:>6.2} GFLOP/s",
+                seconds * 1e3,
+                2.0 * (m * n * k) as f64 / seconds / 1e9
+            );
+        }
+    }
+}
diff -ruN '--exclude=Cargo.lock' a/crates/qarnyx-cpu/src/gemm.rs b/crates/qarnyx-cpu/src/gemm.rs
--- a/crates/qarnyx-cpu/src/gemm.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/qarnyx-cpu/src/gemm.rs	2026-11-18 07:32:18.000000000 +0000
@@ -0,0 +1,90 @@
+//! Register-tiled F32 GEMM micro-kernel used by prompt prefill.
+//!
+//! Computes `C[4][n] = A[4][k] * B[k][n]` where `A` holds four already-decoded
+//! weight rows. Each `B` row segment is loaded once and reused for four weight
+//! rows, so `B` is streamed from cache `m/4` times instead of `m` times, and
+//! every loaded vector feeds four FMAs instead of one.
+
+#![cfg(target_arch = "x86_64")]
+
+use std::arch::x86_64::*;
+
+/// Rows of `A` handled per call.
+pub(crate) const TILE_ROWS: usize = 4;
+
+/// `c = a * b` for four rows. `a` is `[4, k]`, `b` is `[k, n]`, `c` is `[4, n]`,
+/// all row-major. The caller must have verified AVX2+FMA support.
+pub(crate) fn tile_4(a: &[f32], k: usize, b: &[f32], n: usize, c: &mut [f32]) {
+    assert_eq!(a.len(), TILE_ROWS * k, "A must hold exactly four rows");
+    assert_eq!(b.len(), k * n, "B must be [k, n]");
+    assert_eq!(c.len(), TILE_ROWS * n, "C must be [4, n]");
+    // SAFETY: lengths validated above; callers verified AVX2+FMA.
+    unsafe { tile_4_impl(a, k, b, n, c) }
+}
+
+#[target_feature(enable = "avx2,fma")]
+unsafe fn tile_4_impl(a: &[f32], k: usize, b: &[f32], n: usize, c: &mut [f32]) {
+    unsafe {
+        let mut column = 0;
+        while column + 16 <= n {
+            kernel::<2>(
+                a.as_ptr(),
+                k,
+                b.as_ptr().add(column),
+                n,
+                c.as_mut_ptr().add(column),
+            );
+            column += 16;
+        }
+        if column + 8 <= n {
+            kernel::<1>(
+                a.as_ptr(),
+                k,
+                b.as_ptr().add(column),
+                n,
+                c.as_mut_ptr().add(column),
+            );
+        }
+    }
+
+    // Fewer than eight columns remain: scalar.
+    for column in (n - n % 8)..n {
+        for row in 0..TILE_ROWS {
+            let mut sum = 0.0_f32;
+            for inner in 0..k {
+                sum += a[row * k + inner] * b[inner * n + column];
+            }
+            c[row * n + column] = sum;
+        }
+    }
+}
+
+/// 4 rows x (8 * NV) columns, accumulated in registers over the whole `k`.
+///
+/// # Safety
+/// `a` must address `4 * k` floats, `b` must address `k` rows of at least
+/// `8 * NV` floats at stride `n`, and `c` four rows of `8 * NV` floats at stride `n`.
+#[target_feature(enable = "avx2,fma")]
+unsafe fn kernel<const NV: usize>(a: *const f32, k: usize, b: *const f32, n: usize, c: *mut f32) {
+    unsafe {
+        let mut acc = [[_mm256_setzero_ps(); NV]; TILE_ROWS];
+        for inner in 0..k {
+            let b_row = b.add(inner * n);
+            let mut values = [_mm256_setzero_ps(); NV];
+            for (vector, slot) in values.iter_mut().enumerate() {
+                *slot = _mm256_loadu_ps(b_row.add(vector * 8));
+            }
+            for (row, row_acc) in acc.iter_mut().enumerate() {
+                let weight = _mm256_broadcast_ss(&*a.add(row * k + inner));
+                for (vector, slot) in row_acc.iter_mut().enumerate() {
+                    *slot = _mm256_fmadd_ps(weight, values[vector], *slot);
+                }
+            }
+        }
+        for (row, row_acc) in acc.iter().enumerate() {
+            for (vector, slot) in row_acc.iter().enumerate() {
+                _mm256_storeu_ps(c.add(row * n + vector * 8), *slot);
+            }
+        }
+    }
+}
diff -ruN '--exclude=Cargo.lock' a/crates/qarnyx-cpu/src/kq.rs b/crates/qarnyx-cpu/src/kq.rs
--- a/crates/qarnyx-cpu/src/kq.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/qarnyx-cpu/src/kq.rs	2026-11-18 07:32:18.000000000 +0000
@@ -0,0 +1,404 @@
+//! AVX2/FMA direct-block dot products for K-quant weight rows.
+//!
+//! Each kernel computes `dot(weight_row, input)` straight from the packed GGUF
+//! blocks. No F32 copy of the weight row is ever materialized, and the 4-bit /
+//! 5-bit / 6-bit values are unpacked with byte-wise SIMD rather than scalar loops.
+//!
+//! Design notes (why these are faster than the earlier fused Q4_K kernel):
+//! - Scales are applied once per 16/32-element group with a vector FMA, not once
+//!   per weight: `sum(d*sc*q*x - dmin*m*x)` is evaluated as
+//!   `d*sc*sum(q*x) - dmin*m*sum(x)`.
+//! - `sum(x)` per 32-element group is independent of the weight row, so callers
+//!   compute it once per matvec ([`group_sums`]) and reuse it for every row.
+//! - Several independent accumulators hide FMA latency.
+//!
+//! Every public function here is safe to call: it validates lengths with hard
+//! asserts and requires the caller to have verified AVX2+FMA support (see
+//! [`available`]).
+
+#![cfg(target_arch = "x86_64")]
+
+use std::arch::x86_64::*;
+
+/// Elements per K-quant super-block.
+pub(crate) const QK_K: usize = 256;
+const Q4K_BYTES: usize = 144;
+const Q5K_BYTES: usize = 176;
+const Q6K_BYTES: usize = 210;
+
+/// Returns whether the host can run these kernels.
+#[inline]
+pub(crate) fn available() -> bool {
+    is_x86_feature_detected!("avx2") && is_x86_feature_detected!("fma")
+}
+
+/// Sums every 32-element group of `input` into `out` (`out.len() == input.len() / 32`).
+///
+/// Q4_K and Q5_K need `sum(x)` per 32-element group for their min term. It does
+/// not depend on the weights, so one pass per matvec serves every row.
+pub(crate) fn group_sums(input: &[f32], out: &mut [f32]) {
+    assert_eq!(input.len() % 32, 0, "input length must be a multiple of 32");
+    assert_eq!(out.len(), input.len() / 32, "one sum per 32-element group");
+    for (group, slot) in input.chunks_exact(32).zip(out.iter_mut()) {
+        let mut lanes = [0.0_f32; 8];
+        for chunk in group.chunks_exact(8) {
+            for (lane, value) in lanes.iter_mut().zip(chunk) {
+                *lane += *value;
+            }
+        }
+        *slot = lanes.iter().sum();
+    }
+}
+
+#[inline]
+fn half_to_f32(bits: u16) -> f32 {
+    let sign = u32::from(bits & 0x8000) << 16;
+    let exponent = (bits >> 10) & 0x1f;
+    let mantissa = u32::from(bits & 0x03ff);
+    let output = match exponent {
+        0 if mantissa == 0 => sign,
+        0 => {
+            let mut normalized = mantissa;
+            let mut unbiased = -14_i32;
+            while normalized & 0x0400 == 0 {
+                normalized <<= 1;
+                unbiased -= 1;
+            }
+            normalized &= 0x03ff;
+            sign | (((unbiased + 127) as u32) << 23) | (normalized << 13)
+        }
+        0x1f => sign | 0x7f80_0000 | (mantissa << 13),
+        _ => sign | ((u32::from(exponent) + 112) << 23) | (mantissa << 13),
+    };
+    f32::from_bits(output)
+}
+
+#[inline]
+fn read_half(bytes: &[u8]) -> f32 {
+    half_to_f32(u16::from_le_bytes([bytes[0], bytes[1]]))
+}
+
+/// GGML `get_scale_min_k4`: 6-bit scale and min for group `index` (0..8).
+#[inline]
+fn scale_min(index: usize, packed: &[u8]) -> (u8, u8) {
+    if index < 4 {
+        (packed[index] & 0x3f, packed[index + 4] & 0x3f)
+    } else {
+        (
+            (packed[index + 4] & 0x0f) | ((packed[index - 4] >> 6) << 4),
+            (packed[index + 4] >> 4) | ((packed[index] >> 6) << 4),
+        )
+    }
+}
+
+#[inline]
+#[target_feature(enable = "avx2,fma")]
+unsafe fn hsum(v: __m256) -> f32 {
+    let low = _mm256_castps256_ps128(v);
+    let high = _mm256_extractf128_ps::<1>(v);
+    let sum = _mm_add_ps(low, high);
+    let sum = _mm_add_ps(sum, _mm_movehl_ps(sum, sum));
+    let sum = _mm_add_ss(sum, _mm_shuffle_ps::<1>(sum, sum));
+    _mm_cvtss_f32(sum)
+}
+
+/// Loads 8 unsigned bytes starting at `lane` of a 32-byte vector, as `f32`.
+macro_rules! u8_lanes_to_f32 {
+    ($halves:expr, $chunk:expr) => {{
+        // `$halves` is [low128, high128]; chunk 0..4 selects an 8-byte slice.
+        let source = $halves[$chunk / 2];
+        let shifted = if $chunk % 2 == 0 {
+            source
+        } else {
+            _mm_srli_si128::<8>(source)
+        };
+        _mm256_cvtepi32_ps(_mm256_cvtepu8_epi32(shifted))
+    }};
+}
+
+macro_rules! i8_lanes_to_f32 {
+    ($halves:expr, $chunk:expr) => {{
+        let source = $halves[$chunk / 2];
+        let shifted = if $chunk % 2 == 0 {
+            source
+        } else {
+            _mm_srli_si128::<8>(source)
+        };
+        _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(shifted))
+    }};
+}
+
+#[inline]
+#[target_feature(enable = "avx2,fma")]
+unsafe fn halves(v: __m256i) -> [__m128i; 2] {
+    [_mm256_castsi256_si128(v), _mm256_extracti128_si256::<1>(v)]
+}
+
+/// Dot product of one Q4_K row with `input`.
+///
+/// `sums` must come from [`group_sums`] for the same `input`.
+pub(crate) fn dot_q4_k(encoded: &[u8], input: &[f32], sums: &[f32]) -> f32 {
+    let blocks = encoded.len() / Q4K_BYTES;
+    assert_eq!(encoded.len(), blocks * Q4K_BYTES, "partial Q4_K block");
+    assert_eq!(input.len(), blocks * QK_K, "input length must match blocks");
+    assert_eq!(sums.len(), blocks * 8, "one group sum per 32 inputs");
+    // SAFETY: lengths validated above; callers verified `available()`.
+    unsafe { dot_q4_k_impl(encoded, input, sums) }
+}
+
+#[target_feature(enable = "avx2,fma")]
+unsafe fn dot_q4_k_impl(encoded: &[u8], input: &[f32], sums: &[f32]) -> f32 {
+    unsafe {
+        let low_mask = _mm256_set1_epi8(0x0f);
+        let mut acc_even = _mm256_setzero_ps();
+        let mut acc_odd = _mm256_setzero_ps();
+        let mut min_total = 0.0_f32;
+
+        for (block_index, block) in encoded.chunks_exact(Q4K_BYTES).enumerate() {
+            let d = read_half(&block[0..2]);
+            let dmin = read_half(&block[2..4]);
+            let packed_scales = &block[4..16];
+            let quants = block.as_ptr().add(16);
+            let x_base = input.as_ptr().add(block_index * QK_K);
+            let sum_base = block_index * 8;
+
+            for pair in 0..4 {
+                let packed = _mm256_loadu_si256(quants.add(pair * 32).cast());
+                let low = halves(_mm256_and_si256(packed, low_mask));
+                let high = halves(_mm256_and_si256(_mm256_srli_epi16::<4>(packed), low_mask));
+
+                let x_even = x_base.add(pair * 64);
+                let x_odd = x_even.add(32);
+
+                // Even group: low nibbles. Two independent chains of two FMAs.
+                let mut a0 = _mm256_mul_ps(u8_lanes_to_f32!(low, 0), _mm256_loadu_ps(x_even));
+                let mut a1 =
+                    _mm256_mul_ps(u8_lanes_to_f32!(low, 1), _mm256_loadu_ps(x_even.add(8)));
+                a0 = _mm256_fmadd_ps(
+                    u8_lanes_to_f32!(low, 2),
+                    _mm256_loadu_ps(x_even.add(16)),
+                    a0,
+                );
+                a1 = _mm256_fmadd_ps(
+                    u8_lanes_to_f32!(low, 3),
+                    _mm256_loadu_ps(x_even.add(24)),
+                    a1,
+                );
+
+                // Odd group: high nibbles.
+                let mut b0 = _mm256_mul_ps(u8_lanes_to_f32!(high, 0), _mm256_loadu_ps(x_odd));
+                let mut b1 =
+                    _mm256_mul_ps(u8_lanes_to_f32!(high, 1), _mm256_loadu_ps(x_odd.add(8)));
+                b0 = _mm256_fmadd_ps(
+                    u8_lanes_to_f32!(high, 2),
+                    _mm256_loadu_ps(x_odd.add(16)),
+                    b0,
+                );
+                b1 = _mm256_fmadd_ps(
+                    u8_lanes_to_f32!(high, 3),
+                    _mm256_loadu_ps(x_odd.add(24)),
+                    b1,
+                );
+
+                let (sc_even, mn_even) = scale_min(pair * 2, packed_scales);
+                let (sc_odd, mn_odd) = scale_min(pair * 2 + 1, packed_scales);
+                acc_even = _mm256_fmadd_ps(
+                    _mm256_add_ps(a0, a1),
+                    _mm256_set1_ps(d * f32::from(sc_even)),
+                    acc_even,
+                );
+                acc_odd = _mm256_fmadd_ps(
+                    _mm256_add_ps(b0, b1),
+                    _mm256_set1_ps(d * f32::from(sc_odd)),
+                    acc_odd,
+                );
+                min_total += dmin * f32::from(mn_even) * sums[sum_base + pair * 2]
+                    + dmin * f32::from(mn_odd) * sums[sum_base + pair * 2 + 1];
+            }
+        }
+
+        hsum(_mm256_add_ps(acc_even, acc_odd)) - min_total
+    }
+}
